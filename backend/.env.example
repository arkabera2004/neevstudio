# Copy to `.env` and fill in your key. `.env` is gitignored.

# Required — your Gemini API key.
GEMINI_API_KEY=

# Optional — model to use. Defaults to gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest

# Optional — override the Gemini API base URL (e.g. a Vertex AI gateway).
# GEMINI_BASE_URL=

# Optional — comma-separated list of allowed CORS origins for the frontend.
# Defaults cover the Vite dev server on 8080 and the built preview on 3000.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# Optional — Postgres DSN for run history (New Breakdown + AI Capability Map).
# Start it with `docker compose up -d postgres` from the repo root. Leave empty
# to run without history — the app works fine, it just forgets past runs.
DATABASE_URL=postgresql://veritrace:veritrace@localhost:5437/veritrace
