# Rendered at container start by envsubst (only ${PORT} is substituted).
# Public entrypoint: nginx listens on $PORT and reverse-proxies to the two
# internal services.
server {
    listen ${PORT};
    server_name _;

    # Allow large-ish agent responses / uploads.
    client_max_body_size 10m;

    # Backend (FastAPI) — keep the /api prefix (no trailing slash on proxy_pass).
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # LLM calls can take a while — don't cut them off early.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Frontend (TanStack Start / Nitro SSR).
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
